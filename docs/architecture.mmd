    EXE["execution<br/>one backend.run per run<br/>canary bit-order check"]
    ANA["decode + analysis + bounds<br/>Pauli frame, post-selection,<br/>Hoeffding / Wilson, certificates"]
    DATA[("config/defaults.json<br/>data/: Munich 2017 events,<br/>published S and Q,<br/>recorded runs")]
  end
  subgraph BE["Backend injected by Qollab"]
    B1["Built-in / Braket local<br/>(ideal)"]
    B2["IBM noise models<br/>(Aer)"]
    B3["IonQ noise models<br/>(cloud, one job per run)"]
  end
  UI --> API -->|callPromising| APP
  APP --> CIR --> EXE
  EXE --> B1 & B2 & B3
