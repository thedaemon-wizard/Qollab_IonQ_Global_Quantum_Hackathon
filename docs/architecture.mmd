flowchart LR
  subgraph Browser["Qollab project frame (browser)"]
    UI["UI: 8 views + guided tour<br/>ES modules, SVG, three.js"]
    API["ui/core/api.js<br/>only bridge to Python<br/>JSON strings in and out"]
  end
  subgraph Py["Python in Pyodide (bellkit)"]
    APP["bellkit.app<br/>run / theory / circuits / data"]
